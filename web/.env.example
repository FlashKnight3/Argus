# SpacetimeDB endpoint. Defaults to ws://<this page's host>:3000 so a tablet on
# the same Wi-Fi reaches the laptop's database without configuration.
# VITE_SPACETIMEDB_HOST=ws://192.168.1.20:3000
VITE_SPACETIMEDB_DB_NAME=argus

# Local LLM for the handoff assistant (Ollama). Leave unset to use the default.
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=llama3.2:3b
